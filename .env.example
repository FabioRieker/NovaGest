# Plantilla de variables de entorno para Supabase
# Copia este archivo como .env y rellena con las credenciales de tu proyecto:
#
# 1. SUPABASE_URL: URL de tu instancia (Project Settings > API)
# 2. SUPABASE_ANON_KEY: Clave publica anon (Project Settings > API)
#
# Nota: Nunca uses la clave service_role en el frontend ni subas el archivo .env a Git.

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=SUPABASE_ANON_KEY_PLACEHOLDER
